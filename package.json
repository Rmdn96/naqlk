{
  "name": "naqlk",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise logistics SaaS platform foundation for Saudi Arabia.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "security:audit": "npm audit --audit-level=high",
    "brand:scan": "node scripts/verify-brand-remnants.mjs",
    "seo:editorial:check": "node scripts/seo/generate-editorial-rollout-v1.mjs --check && node scripts/seo/generate-editorial-scope-correction-v1.mjs --check",
    "docs:links:check": "node scripts/validate-internal-links.mjs",
    "supabase:migrations:verify": "node scripts/supabase/verify-migration-drift.mjs",
    "supabase:staff:provision": "node --env-file-if-exists=.env.local scripts/supabase/provision-staff.mjs",
    "supabase:storage:check": "node --env-file-if-exists=.env.local scripts/supabase/initialize-storage.mjs --check",
    "supabase:storage:init": "node --env-file-if-exists=.env.local scripts/supabase/initialize-storage.mjs --apply",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run seo:editorial:check && npm run docs:links:check && npm run brand:scan && npm run security:audit",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.18": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.5",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.12"
    },
    "nanoid": "6.0.2",
    "postcss": "8.5.31",
    "postcss-selector-parser": "6.1.5",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "shadcn": {
      "postcss-selector-parser": "7.1.7",
      "undici": "7.30.1"
    },
    "undici@^7": "7.30.1",
    "undici@^8": "8.12.3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@swc/helpers": "0.5.23",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "postcss": "8.5.31",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "@playwright/test": "1.64.1",
    "shadcn": "4.22.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
