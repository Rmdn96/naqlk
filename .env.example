# Application
# Canonical public origin used by production SEO metadata and sitemap output.
NEXT_PUBLIC_APP_URL=https://naqlk.com
# Server-only, branch-scoped Vercel Preview callback origin. Leave empty in Production.
# Example: https://naqlk-git-feature-name-owner.vercel.app
# The exact value and /auth/callback path must be allowlisted in Supabase before
# running signup, recovery, OAuth, or invitation acceptance on that Preview.
NAQLK_AUTH_PREVIEW_ORIGIN=
# Optional server-only override for an approved local callback origin.
NAQLK_AUTH_LOCAL_ORIGIN=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SUPPORTED_LOCALES=ar,en
# Interim public fallback until Business Settings Management owns this value.
# Saudi international format only: country code + mobile number, without + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=966547349947
# Optional interim fallback until Business Settings owns the Google Review URL.
# Leave empty to hide the non-gated Google Review CTA.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Sales workspace fallback until Business Settings Management is implemented.
# Express as a decimal (for example, 0.15 for 15%). Do not expose this through NEXT_PUBLIC_.
NAQLK_DEFAULT_QUOTATION_VAT_RATE=0.15
NAQLK_DEFAULT_QUOTATION_VALIDITY_DAYS=7

# Supabase - public connection values from the project Connect dialog
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Authentication provider availability - Google appears only after dashboard setup and callback acceptance.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Google Ads tracking is disabled unless the deployment explicitly enables it
# and the visitor grants advertising consent in the runtime preference prompt.
# NEXT_PUBLIC_ values are embedded at build time; rebuild after changing them.
NEXT_PUBLIC_GOOGLE_ADS_TRACKING_ENABLED=false
# Set true only for an explicitly approved non-production test environment.
NEXT_PUBLIC_GOOGLE_ADS_TESTING=false
# Production conversion action label. It is inert while tracking or consent is disabled.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=625xCKaL_58dEN34s_5E
# Apple remains prepared for compatibility but is intentionally absent from the ordinary public UI.
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Supabase - optional server-only key for storage reconciliation and staff provisioning
# Never expose this value with a NEXT_PUBLIC_ prefix or use it in application clients.
SUPABASE_SECRET_KEY=

# Operator/CI only: direct PostgreSQL connection used by the read-only migration-drift check.
# Store this in an approved secret manager; never expose it to the browser or Vercel application runtime.
SUPABASE_DB_URL=
